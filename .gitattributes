# 统一行尾：仓库内一律 LF，避免 Windows 工作区 CRLF 污染提交与镜像构建
* text=auto eol=lf

# 明确二进制类型，禁止任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.gz binary
*.wasm binary
*.zip binary

# 需要保持 LF 的脚本
*.sh text eol=lf
Dockerfile text eol=lf
